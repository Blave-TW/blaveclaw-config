//@version=6
// Blave Agent export template — TradingView Pine Script v6
// Template:  breakout_nbar
// Logic:     long when close breaks above the prior N-bar high; flat when close breaks below the prior M-bar low.
//            "Prior" = excludes the current bar, i.e. Python High.rolling(N).max().shift(1).
// Blave ref: Type A pattern (strategy-code.md), same signal shape as examples/btc_sma_cross
// Chart:     set symbol and timeframe by hand.
// Costs:     commission 0.05 % per side = Blave FEE 0.0005; slippage 0 like Blave.
// Not compiled by Blave Agent. Add to a chart, open the Strategy Tester, check the trade list before use.
strategy("Blave: N-bar Breakout", overlay = true, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 0, pyramiding = 1, process_orders_on_close = false, calc_on_every_tick = false)

// --- inputs ---
int entryLen = input.int(20, "Breakout lookback (bars)", minval = 1)
int exitLen  = input.int(10, "Exit lookback (bars)", minval = 1)

// --- signal ---
float priorHigh = ta.highest(high, entryLen)[1]   // Python: df['High'].rolling(entryLen).max().shift(1)
float priorLow  = ta.lowest(low, exitLen)[1]      // Python: df['Low'].rolling(exitLen).min().shift(1)
bool breakUp   = close > priorHigh                // Python: signal[Close > priorHigh] = 1.0
bool breakDown = close < priorLow                 // Python: signal[Close < priorLow] = 0.0

// --- orders ---
// Signal on bar close, fill at next bar open (strategy() default) — same as Blave.
if breakUp and strategy.position_size == 0
    strategy.entry("L", strategy.long)
if breakDown and strategy.position_size > 0
    strategy.close("L")

// --- plots ---
plot(priorHigh, "Entry level", color = color.green)
plot(priorLow, "Exit level", color = color.red)
